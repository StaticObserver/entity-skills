{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://entity-skills.local/schemas/observability/result-v1.json",
  "title": "Entity skill observability derived result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "terminal_status",
    "last_seq",
    "decisions",
    "tool_calls",
    "artifacts",
    "validations",
    "usage",
    "terminal_event_id"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "terminal_status": {"enum": ["completed", "failed", "incomplete"]},
    "last_seq": {"type": "integer", "minimum": 0},
    "decisions": {"type": "integer", "minimum": 0},
    "tool_calls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "failed"],
      "properties": {
        "total": {"type": "integer", "minimum": 0},
        "failed": {"type": "integer", "minimum": 0}
      }
    },
    "artifacts": {"type": "integer", "minimum": 0},
    "validations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pass", "fail", "unknown"],
      "properties": {
        "pass": {"type": "integer", "minimum": 0},
        "fail": {"type": "integer", "minimum": 0},
        "unknown": {"type": "integer", "minimum": 0}
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_tokens", "output_tokens", "wall_time_ms"],
      "properties": {
        "input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "wall_time_ms": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "terminal_event_id": {"type": ["string", "null"]}
  }
}

