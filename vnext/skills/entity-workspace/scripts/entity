#!/bin/sh
set -eu

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

for candidate in \
  "$script_dir/../../../bin/entity" \
  "$script_dir/../../bin/entity"
do
  if [ -x "$candidate" ]; then
    exec "$candidate" "$@"
  fi
done

echo "entity vNext runtime not found next to the installed skill bundle" >&2
exit 127
