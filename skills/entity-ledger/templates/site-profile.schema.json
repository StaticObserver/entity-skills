{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Entity Ledger Site profile",
  "type": "object",
  "required": ["schema_version", "site_id", "transport", "scheduler"],
  "additionalProperties": true,
  "properties": {
    "schema_version": {"const": 1},
    "site_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]+$",
      "description": "Stable identifier; locators are (site_id, absolute path)."
    },
    "display_name": {"type": "string"},
    "transport": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["local", "ssh"]},
        "ssh_alias": {
          "type": "string",
          "description": "Required when kind=ssh; an alias from ~/.ssh/config."
        }
      }
    },
    "scheduler": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": {"enum": ["none", "slurm", "pbs", "custom"]}
      }
    },
    "site_root": {
      "type": "string",
      "pattern": "^/",
      "description": "Computation Site tree root. When present, new build/run/staging resources land in <site_root>/projects/<project>/{builds,runs,staging}/<case>/<id> and roots below is only a legacy fallback."
    },
    "roots": {
      "type": "object",
      "description": "Legacy layout: independent absolute roots, no shared parent required. Profiles with site_root derive the execution roots from the site tree instead.",
      "properties": {
        "source_root": {"type": "string", "pattern": "^/"},
        "build_root": {"type": "string", "pattern": "^/"},
        "run_root": {"type": "string", "pattern": "^/"},
        "staging_root": {"type": "string", "pattern": "^/"},
        "data_root": {"type": "string", "pattern": "^/"}
      },
      "additionalProperties": {"type": "string", "pattern": "^/"}
    },
    "machine": {
      "type": "object",
      "description": "Machine facts probed by `entityctl site discover` and recorded in the site archive.",
      "properties": {
        "os": {"type": "string"},
        "arch": {"type": "string"},
        "gpus": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": true
    },
    "projects": {
      "type": "array",
      "items": {"type": "string"},
      "description": "Project slugs that have a subtree under <site_root>/projects/."
    },
    "deps": {
      "type": "array",
      "description": "Shared dependency stacks registered for this Site (see the site archive deps registry).",
      "items": {
        "type": "object",
        "required": ["stack_id"],
        "properties": {
          "stack_id": {"type": "string"},
          "status": {"enum": ["verified", "suspect", "broken"]},
          "packages": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {"type": "string"},
                "version": {"type": "string"},
                "prefix": {"type": "string"}
              }
            }
          },
          "recipe": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "policy": {
      "type": "object",
      "description": "Safe defaults; run `entityctl site discover <site>` to enumerate legal values before filling these.",
      "properties": {
        "default_partition": {"type": "string"},
        "default_qos": {"type": "string"},
        "default_submit_user": {"type": "string"},
        "default_cpus_per_gpu": {"type": "integer", "minimum": 1},
        "max_cpu_per_gpu": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": true
    },
    "shared_mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["peer_site_id", "this_root", "peer_root"],
        "properties": {
          "peer_site_id": {"type": "string"},
          "this_root": {"type": "string", "pattern": "^/"},
          "peer_root": {"type": "string", "pattern": "^/"}
        }
      }
    }
  }
}
