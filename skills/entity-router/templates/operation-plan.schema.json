{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://entity-router.local/schemas/operation-plan-v1.json",
  "title": "Entity Router Plan Envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "status", "state_mutated", "goal", "plan", "summary"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "entity-router.plan"},
    "status": {"const": "ready"},
    "state_mutated": {"const": false},
    "goal": {"$ref": "goal.schema.json"},
    "plan": {
      "type": "object",
      "required": ["schema_version", "operation_id", "case_uid", "project_root", "goal_hash", "plan_hash", "steps"],
      "properties": {
        "schema_version": {"const": 1},
        "operation_id": {"type": "string", "pattern": "^op-[0-9a-f]{16}$"},
        "case_uid": {"type": "string", "minLength": 1},
        "project_root": {"type": "string", "pattern": "^/"},
        "goal_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "plan_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "steps": {"type": "array", "minItems": 1}
      }
    },
    "summary": {"type": "object"}
  }
}
