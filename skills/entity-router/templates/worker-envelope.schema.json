{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "entity-router-worker-envelope-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case_uid", "action_id", "owner", "execution_domain", "request", "request_hash", "skill", "playbook", "worker_result"],
  "properties": {
    "schema_version": {"const": 1},
    "case_uid": {"type": "string", "minLength": 1},
    "action_id": {"type": "string", "minLength": 1},
    "owner": {"type": "string", "minLength": 1},
    "execution_domain": {"type": "string", "minLength": 1},
    "request": {"type": "object"},
    "request_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "skill": {"type": "string", "minLength": 1},
    "playbook": {"type": "string"},
    "worker_result": {"type": "object"}
  }
}
