{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "entity-router-dispatch-receipt-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case_uid", "action_id", "flow_request_hash", "runner", "state", "attempt", "intent_written_at", "effect_identity", "outputs", "stdout", "stderr"],
  "properties": {
    "schema_version": {"const": 1},
    "case_uid": {"type": "string", "minLength": 1},
    "action_id": {"type": "string", "minLength": 1},
    "flow_request_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "runner": {"type": "string", "minLength": 1},
    "state": {"enum": ["intent_written", "effect_observed", "outputs_verified"]},
    "attempt": {"type": "integer", "minimum": 1},
    "intent_written_at": {"type": "string", "minLength": 1},
    "effect_identity": {"type": "object"},
    "outputs": {"type": "array"},
    "stdout": {"$ref": "#/definitions/stream"},
    "stderr": {"$ref": "#/definitions/stream"}
  },
  "definitions": {
    "stream": {
      "type": "object",
      "required": ["sha256", "bytes", "tail"],
      "properties": {
        "sha256": {"type": "string"},
        "bytes": {"type": "integer", "minimum": 0},
        "tail": {"type": "string"}
      }
    }
  }
}
