{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "entity-router-flow-result-v1",
  "type": "object",
  "required": ["schema_version", "status", "case_uid", "revision", "flow_id", "result", "issues", "artifact_refs", "metrics"],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"enum": ["pass", "completed", "observe_only", "needs_decision", "blocked", "anomaly", "invalid_request", "revision_conflict"]},
    "case_uid": {"type": "string"},
    "revision": {"type": "integer", "minimum": 0},
    "flow_id": {"type": "string"},
    "result": {"type": "object"},
    "issues": {"type": "array"},
    "artifact_refs": {"type": "array"},
    "metrics": {
      "type": "object",
      "required": ["tool_calls", "remote_calls", "output_bytes"],
      "properties": {
        "tool_calls": {"type": "integer", "minimum": 0},
        "remote_calls": {"type": "integer", "minimum": 0},
        "output_bytes": {"type": "integer", "minimum": 0}
      }
    }
  }
}
