{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "entity-router-flow-check-v1",
  "type": "object",
  "required": ["schema_version", "status", "case_uid", "revision", "issues"],
  "properties": {
    "schema_version": {"const": 1},
    "status": {"enum": ["pass", "needs_decision", "blocked", "anomaly"]},
    "case_uid": {"type": "string"},
    "revision": {"type": "integer", "minimum": 0},
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "class", "message", "subject", "evidence_fingerprint", "artifact_ref"]
      }
    }
  }
}
