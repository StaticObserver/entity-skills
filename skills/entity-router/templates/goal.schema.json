{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://entity-router.local/schemas/goal-v1.json",
  "title": "Entity Router GoalSpec v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "input", "site", "compute"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "run"},
    "input": {"type": "string", "minLength": 1},
    "site": {"type": "string", "minLength": 1},
    "executable": {"type": "string", "minLength": 1},
    "case_id": {"type": "string", "minLength": 1},
    "source_mode": {"enum": ["git-ref", "snapshot", "shared", "external"]},
    "labels": {"type": "object", "additionalProperties": {"type": "string"}},
    "compute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gpus", "walltime", "precision"],
      "properties": {
        "nodes": {"type": "integer", "minimum": 1},
        "tasks": {"type": "integer", "minimum": 1},
        "gpus": {"type": "integer", "minimum": 1},
        "cpus_per_task": {"type": "integer", "minimum": 1},
        "walltime": {"type": "string", "pattern": "^[0-9]+(?:-[0-9]{2})?:[0-9]{2}:[0-9]{2}$"},
        "partition": {"type": "string"},
        "qos": {"type": "string"},
        "submit_user": {"type": "string"},
        "precision": {"enum": ["single", "double"]}
      }
    }
  }
}
