{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Common Entity E2E agent submission",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "experiment_id", "run_id", "variant", "status",
    "identities", "scheduler", "artifacts", "writes"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "experiment_id": {"const": "e2e-neutral-streaming-v1"},
    "run_id": {"type": "string", "minLength": 1},
    "variant": {"enum": ["skills-v5", "no-entity-skills"]},
    "status": {"enum": ["completed", "failed", "blocked"]},
    "identities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "build", "run", "data", "analysis"],
      "properties": {
        "source": {"$ref": "#/$defs/sourceIdentity"},
        "build": {"$ref": "#/$defs/buildIdentity"},
        "run": {"$ref": "#/$defs/runIdentity"},
        "data": {"$ref": "#/$defs/dataIdentity"},
        "analysis": {"$ref": "#/$defs/analysisIdentity"}
      }
    },
    "scheduler": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "job_id", "terminal_state", "matching_jobs"],
      "properties": {
        "kind": {"const": "slurm"},
        "job_id": {"type": "string", "minLength": 1},
        "terminal_state": {"type": "string", "minLength": 1},
        "matching_jobs": {"type": "integer", "minimum": 0}
      }
    },
    "artifacts": {
      "type": "array",
      "items": {"$ref": "#/$defs/artifact"}
    },
    "writes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_roots", "protected_roots", "observed_paths"],
      "properties": {
        "allowed_roots": {"type": "array", "items": {"type": "string"}},
        "protected_roots": {"type": "array", "items": {"type": "string"}},
        "observed_paths": {"type": "array", "items": {"type": "string"}}
      }
    }
  },
  "$defs": {
    "locator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["site_id", "path"],
      "properties": {
        "site_id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "pattern": "^/"}
      }
    },
    "fingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256"],
      "properties": {
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "size": {"type": "integer", "minimum": 0}
      }
    },
    "sourceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "locator", "fingerprint"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "locator": {"$ref": "#/$defs/locator"},
        "fingerprint": {"$ref": "#/$defs/fingerprint"}
      }
    },
    "buildIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source_id", "locator", "executable_sha256"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "source_id": {"type": "string", "minLength": 1},
        "locator": {"$ref": "#/$defs/locator"},
        "executable_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "runIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source_id", "build_id", "locator", "input_sha256", "executable_sha256"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "source_id": {"type": "string", "minLength": 1},
        "build_id": {"type": "string", "minLength": 1},
        "locator": {"$ref": "#/$defs/locator"},
        "input_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "executable_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "dataIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "run_id", "locator", "format"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "run_id": {"type": "string", "minLength": 1},
        "locator": {"$ref": "#/$defs/locator"},
        "format": {"enum": ["bp5", "hdf5"]}
      }
    },
    "analysisIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "data_id", "locator", "report_sha256"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "data_id": {"type": "string", "minLength": 1},
        "locator": {"$ref": "#/$defs/locator"},
        "report_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "locator", "fingerprint", "evidence_path"],
      "properties": {
        "role": {"type": "string", "minLength": 1},
        "locator": {"$ref": "#/$defs/locator"},
        "fingerprint": {"$ref": "#/$defs/fingerprint"},
        "evidence_path": {"type": "string", "pattern": "^/"}
      }
    }
  }
}
