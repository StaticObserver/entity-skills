{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Independent Slurm snapshot for one Router Operation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scheduler", "observed_at", "query", "jobs"],
  "properties": {
    "schema_version": {"const": 1},
    "scheduler": {"const": "slurm"},
    "observed_at": {"type": "string"},
    "query": {"type": "object"},
    "jobs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["job_id", "job_name", "submit_user", "run_root", "comment", "state"]
      }
    }
  }
}
