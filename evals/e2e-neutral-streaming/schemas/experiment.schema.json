{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Neutral streaming paired experiment definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "experiment_id", "task", "physics_spec",
    "submission_schema", "source", "analysis", "variants", "protocol", "freeze"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "experiment_id": {"const": "e2e-neutral-streaming-v1"},
    "task": {"type": "string", "minLength": 1},
    "physics_spec": {"type": "string", "minLength": 1},
    "submission_schema": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project", "ref", "commit", "source_cache_sha256"],
      "properties": {
        "project": {"type": "string", "minLength": 1},
        "ref": {"const": "v1.4.4"},
        "commit": {"type": "string"},
        "source_cache_sha256": {"type": "string"}
      }
    },
    "analysis": {"type": "object"},
    "variants": {"type": "array", "minItems": 2, "maxItems": 2},
    "protocol": {"type": "object"},
    "freeze": {
      "type": "object",
      "required": ["status", "formal_execution_allowed", "unresolved"],
      "properties": {
        "status": {"enum": ["pre_gold", "frozen"]},
        "formal_execution_allowed": {"type": "boolean"},
        "unresolved": {"type": "array"}
      }
    }
  }
}
