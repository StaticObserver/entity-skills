{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "submission.schema.json",
  "title": "e2e-neutral-streaming submission",
  "type": "object",
  "$comment": "This schema covers exactly the fields the oracle (evals/e2e-neutral-streaming/oracle) consumes. It is deliberately permissive otherwise (additional properties are allowed). Compatibility note: the entity-ledger 0.5.0 `entityctl submission create` document (kind=entity-ledger.submission, with case_uid/identities/artifacts[]/fingerprint) has a different shape and does NOT by itself satisfy this schema — agents using entityctl must merge the oracle-consumed fields below (experiment_id, run.data_root, analysis.report, analysis.script, ...) into the same submission.json. The oracle reads run.data_root with a fallback to output.data_root, mirrored here by the anyOf.",
  "required": ["experiment_id", "analysis"],
  "properties": {
    "experiment_id": {"const": "e2e-neutral-streaming-v1"},
    "toml_input": {
      "type": "object",
      "properties": {
        "path": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "run": {
      "type": "object",
      "properties": {
        "slurm_job_id": {"type": ["string", "integer"]},
        "partition": {"type": "string"},
        "resources": {
          "type": "object",
          "properties": {
            "tasks": {"type": "integer", "minimum": 1},
            "nodes": {"type": "integer", "minimum": 1},
            "gpus": {"type": "integer", "minimum": 0}
          }
        },
        "data_root": {"type": "string", "minLength": 1},
        "walltime": {"type": "string"}
      }
    },
    "output": {
      "type": "object",
      "properties": {
        "data_root": {"type": "string", "minLength": 1}
      }
    },
    "physics_spec": {
      "type": "object",
      "properties": {
        "resource_ceiling": {
          "type": "object",
          "properties": {
            "walltime": {"type": "string"}
          }
        }
      }
    },
    "analysis": {
      "type": "object",
      "required": ["report", "script"],
      "properties": {
        "report": {"type": "string", "minLength": 1},
        "script": {"type": "string", "minLength": 1}
      }
    }
  },
  "allOf": [
    {
      "anyOf": [
        {
          "required": ["run"],
          "properties": {"run": {"type": "object", "required": ["data_root"]}}
        },
        {
          "required": ["output"],
          "properties": {"output": {"type": "object", "required": ["data_root"]}}
        }
      ]
    }
  ]
}
