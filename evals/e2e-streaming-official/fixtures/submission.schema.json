{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "submission.schema.json",
  "title": "e2e-streaming-official submission",
  "type": "object",
  "$comment": "This schema covers exactly the fields the oracle (evals/e2e-streaming-official/oracle) consumes. It is deliberately permissive otherwise (additional properties are allowed). The entity-ledger `entityctl submission create` document (kind=entity-ledger.submission) has a different shape and does NOT by itself satisfy this schema — agents using entityctl must merge the oracle-consumed fields below into the same submission.json. The oracle reads run.data_root with a fallback to output.data_root, mirrored here by the anyOf.",
  "required": ["experiment_id", "analysis"],
  "properties": {
    "experiment_id": {"const": "e2e-streaming-official-v1"},
    "official_pgen": {
      "type": "object",
      "required": ["name", "sha256"],
      "properties": {
        "name": {"const": "streaming"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "toml_input": {
      "type": "object",
      "properties": {
        "path": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "run": {
      "type": "object",
      "properties": {
        "scheduler": {
          "type": "object",
          "properties": {
            "kind": {"enum": ["direct", "slurm"]},
            "pid": {"type": ["integer", "string"]},
            "job_id": {"type": ["string", "integer"]}
          }
        },
        "exit_code": {"type": "integer"},
        "walltime_seconds": {"type": "integer", "minimum": 0},
        "resources": {
          "type": "object",
          "properties": {
            "tasks": {"type": "integer", "minimum": 1},
            "nodes": {"type": "integer", "minimum": 1},
            "gpus": {"type": "integer", "minimum": 0}
          }
        },
        "data_root": {"type": "string", "minLength": 1}
      }
    },
    "output": {
      "type": "object",
      "properties": {
        "data_root": {"type": "string", "minLength": 1}
      }
    },
    "physics_spec": {
      "type": "object"
    },
    "analysis": {
      "type": "object",
      "required": ["report", "script"],
      "properties": {
        "report": {"type": "string", "minLength": 1},
        "script": {"type": "string", "minLength": 1},
        "analysis_id": {"type": "string"},
        "env_stack": {"type": "string"}
      }
    }
  },
  "anyOf": [
    {"required": ["run"]},
    {"required": ["output"]}
  ]
}
